# The dev verifier's settings. Copy to dev.env on the server, fill it in, and keep it root-only:
#   sudo cp dev.env.example dev.env && sudo chmod 600 dev.env && sudo chown root:root dev.env
# Never commit dev.env (deploy/*.env is ignored by git) or paste its values anywhere.
# One setting per line, no quotes and no comment after a value.

# Passwords for the verifier's own Postgres: the superuser's, and the app's login (verifier_app). Make each with
# openssl rand -hex 32 (hex: no @, / or : to break the database URL).
POSTGRES_PASSWORD=
VERIFIER_DB_PASSWORD=

# From gw_sales: they sign their requests with the webhook secret, we sign our results with the callback secret,
# and send the API key as X-API-Key with our results. Each secret at least 32 characters (openssl rand -hex 32).
VERIFIER_WEBHOOK_SECRET=
VERIFIER_CALLBACK_SECRET=
VERIFIER_API_KEY=
GW_SALES_URL=https://dev-sales.greenworms.org

# Only while changing the webhook secret: the new one, accepted as well as the old until gw_sales has switched.
# VERIFIER_WEBHOOK_SECRET_NEXT=

# The photos: the bucket holding disposal/* and collection-logs/*, a read-only key for those two, and the bucket's
# region (such as ap-south-1).
VERIFIER_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Jev.
TYPESAFE_API_KEY=

# The client project code that marks a Verra project trip; left out, no Verra checks.
# VERIFIER_VERRA_PROJECT=

# The port on the server (127.0.0.1 only) the HTTPS proxy forwards to; left out, 8080. Change the proxy's with it.
# VERIFIER_PORT=8080
