{
  "orientation": {
    "type": "choice",
    "instructions": "Which way is the printed text in `photo` turned?",
    "criteria": {
      "upright": "The text reads normally, left to right.",
      "top_points_right": "The image is turned so the tops of the letters face the right edge.",
      "top_points_left": "The image is turned so the tops of the letters face the left edge.",
      "upside_down": "The text is upside down."
    }
  },
  "shows_vehicle": {
    "type": "noul",
    "instructions": "Does `photo` show a motor vehicle, such as a truck, tipper, pickup or van?"
  },
  "gps_stamp": {
    "type": "noul",
    "instructions": "Is a GPS stamp printed on `photo`?",
    "criteria": {
      "true": "A block of text printed on the photo by a GPS camera app, with a place name or address, latitude and longitude, and a date and time. It may have a map, a logo, or neither.",
      "false": "No such block of text, or only a date and time with no place or coordinates."
    }
  },
  "screen_photo": {
    "type": "noul",
    "instructions": "Is `photo` a picture of a screen, such as a phone or computer showing another photo, rather than a photo taken directly?",
    "criteria": {
      "true": "A screen was photographed: its edge, glare, cracked glass, an app's bars or buttons, or screen pixels show.",
      "false": "A photo taken directly of the scene."
    }
  },
  "plate": {
    "type": "choice",
    "instructions": "How well can the registration number on the vehicle's number plate in `photo` be read?",
    "criteria": {
      "not_visible": "No number plate of the vehicle is in view.",
      "partly_readable": "A number plate is in view, but some of its letters or digits are hidden, blurred, dirty, cut off or too small to read.",
      "readable": "Every letter and digit on the number plate can be read."
    }
  },
  "plate_number": {
    "type": "choice",
    "instructions": "Is the registration number on the vehicle's number plate in `photo` the same as `vehicle_number`? Compare only the letters and digits, ignoring spaces, hyphens, dots, line breaks and letter case. They are the same only if every letter and digit matches, in the same order.",
    "criteria": {
      "different": "At least one letter or digit on the plate differs from `vehicle_number`, or is missing or extra.",
      "same": "The plate shows the same letters and digits as `vehicle_number`, in the same order.",
      "cannot_tell": "No number plate is in view, or it can't be read well enough to compare."
    }
  },
